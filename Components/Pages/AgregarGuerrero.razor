@page "/guerrero"

@using ParcialRPG.Models
@using ParcialRPG.Data

<h3>Registrar Guerrero</h3>

<EditForm Model="guerrero" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-2">
        <label>Nombre:</label>
        <InputText @bind-Value="guerrero.Nombre" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Nivel:</label>
        <InputNumber @bind-Value="guerrero.Nivel" class="form-control" />
    </div>

    <div class="mb-2">
        <label>PV:</label>
        <InputNumber @bind-Value="guerrero.PV" class="form-control" />
    </div>

    <div class="mb-2">
        <label>XP:</label>
        <InputNumber @bind-Value="guerrero.XP" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Tipo de arma:</label>

        <InputSelect @bind-Value="guerrero.TipoArma" class="form-control">
            <option value="">Seleccione</option>
            <option>Espada</option>
            <option>Hacha</option>
            <option>Martillo</option>
            <option>Lanza</option>
        </InputSelect>
    </div>

    <div class="mb-2">
        <label>Defensa física:</label>
        <InputNumber @bind-Value="guerrero.DefensaFisica" class="form-control" />
    </div>

    <button class="btn btn-primary">Guardar</button>

</EditForm>

@code {

    Guerrero guerrero = new Guerrero();

    void Guardar()
    {
        JuegoData.Personajes.Add(guerrero);

        guerrero = new Guerrero();
    }
}